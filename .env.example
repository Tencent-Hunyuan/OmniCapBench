# ============================================================
# OmniCapBench - environment variables
# ============================================================
# Copy this file to .env and fill in only what you need.
# Do NOT commit .env to version control.
#
# Every variable below is a default for a command-line flag. Anything passed on
# the command line wins, so a run can always be reproduced from shell history.

# ============ Evaluation set ============
# Annotations built with omnicapbench_pipeline, or any JSONL in the same shape.
OMNICAP_EVAL_INPUT_JSONL=examples/eval_sample.jsonl
# Directory that relative video_path entries are resolved against.
OMNICAP_EVAL_VIDEO_ROOT=

# ============ Evaluated models: cloud ============

# Google Gemini (official google-genai SDK)
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OMNICAP_EVAL_GEMINI31_MODEL=gemini-3.1-pro
OMNICAP_EVAL_GEMINI25_MODEL=gemini-2.5-pro

# Qwen / DashScope (OpenAI-compatible)
# Key: https://dashscope.console.aliyun.com/
OMNICAP_EVAL_QWEN35_API_KEY=
OMNICAP_EVAL_QWEN35_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OMNICAP_EVAL_QWEN35_MODEL=qwen3.5-omni-plus
OMNICAP_EVAL_QWEN35_FLASH_MODEL=qwen3.5-omni-flash

# OpenRouter (one key, 200+ models)
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OMNICAP_EVAL_OPENROUTER_MODEL=google/gemini-2.5-pro

# OpenAI
OPENAI_API_KEY=

# ============ Evaluated models: local vLLM servers ============
# Started with: bash scripts/serve_vllm.sh MODEL_PATH PORT
OMNICAP_EVAL_QWEN3_BASE_URL=http://localhost:8903/v1
OMNICAP_EVAL_QWEN3_API_KEY=EMPTY
OMNICAP_EVAL_QWEN3_MODEL=Qwen3-Omni-30B-A3B-Instruct

OMNICAP_EVAL_QWEN25_BASE_URL=http://localhost:8903/v1
OMNICAP_EVAL_QWEN25_API_KEY=EMPTY
OMNICAP_EVAL_QWEN25_MODEL=Qwen2.5-Omni-7B

# Local checkpoint directory, and the token used to download into it.
OMNICAP_EVAL_MODELS_DIR=omnicapbench_eval/models
# Token: https://huggingface.co/settings/tokens
HF_TOKEN=

# ============ LLM judge (localized semantic scoring) ============
# Any OpenAI-compatible endpoint. The judge only performs bounded local
# comparisons, so it does not need a frontier-level model.
OMNICAP_EVAL_JUDGE_BASE_URL=https://api.openai.com/v1
OMNICAP_EVAL_JUDGE_MODEL=gpt-4o
OMNICAP_EVAL_JUDGE_API_KEY=
OMNICAP_EVAL_JUDGE_TEMPERATURE=0.7
OMNICAP_EVAL_JUDGE_MAX_TOKENS=4096

# ============ LLM-assisted reference matching ============
# Used by the rule-based metrics for Ref, RefUse and CCC.
# scripts/eval_all_metrics.sh sets these from the judge settings automatically.
# If both BASE_URL and API_KEY are unset, matching falls back to exact ID
# matching and the rule-based metrics run fully offline.
REF_MATCH_BASE_URL=
REF_MATCH_MODEL=gpt-4o
REF_MATCH_API_KEY=
REF_MATCH_TEMPERATURE=0.0
REF_MATCH_MAX_TOKENS=4096
REF_MATCH_TIMEOUT=600
REF_MATCH_MAX_RETRIES=5

# ============ Free-form caption to MTSS conversion ============
# Only needed when evaluating captioners that cannot follow the structured schema.
OMNICAP_EVAL_CONVERT_BASE_URL=https://api.openai.com/v1
OMNICAP_EVAL_CONVERT_MODEL=gpt-4o
OMNICAP_EVAL_CONVERT_API_KEY=
OMNICAP_EVAL_CONVERT_WORKERS=4

# ============ Evaluation output locations ============
OMNICAP_EVAL_OUTPUT_DIR=output/eval
OMNICAP_EVAL_LOG_DIR=logs/eval
OMNICAP_EVAL_VIDEO_CACHE_DIR=video_cache

# ============ Annotation generation pipeline ============
OMNICAP_QWEN_OMNI_BASE_URL=http://localhost:8000/v1
OMNICAP_QWEN_OMNI_API_KEY=EMPTY
OMNICAP_QWEN_OMNI_MODEL=qwen-omni

OMNICAP_INPUT_JSON=examples/generation_input_sample.json
OMNICAP_OUTPUT_DIR=output/generation
OMNICAP_LOG_DIR=logs/generation
OMNICAP_NUM_WORKERS=16

# Long videos are processed in shot chunks.
OMNICAP_SHOT_CHUNK_SIZE=10
OMNICAP_SHOT_CHUNK_THRESHOLD=22

# ============ External tools ============
OMNICAP_FFMPEG_PATH=ffmpeg
OMNICAP_FFPROBE_PATH=ffprobe
OMNICAP_EVAL_FFMPEG_PATH=ffmpeg
OMNICAP_EVAL_FFPROBE_PATH=ffprobe
